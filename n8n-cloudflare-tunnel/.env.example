# Public hostname configured in Cloudflare Tunnel (without https://)
N8N_HOST=n8n.example.com

# IMPORTANT: use the existing key from your current n8n setup.
# Do not replace it if you already have saved credentials/workflows.
N8N_ENCRYPTION_KEY=REPLACE_WITH_YOUR_EXISTING_N8N_ENCRYPTION_KEY

# Token for your named Cloudflare Tunnel. Keep this secret.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_TUNNEL_TOKEN
